{
  "manifest_version": 3,
  "name": "QuickNotes",
  "short_name": "QuickNotes",
  "version": "1.2.0",
  "description": "Jot a note for today in a second, from any tab. Syncs with QuickNotes on your Mac and phone.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "QuickNotes (⌥⇧N)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Open QuickNotes"
    }
  },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ]
}
